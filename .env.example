# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Web Push VAPID Keys (Generate once with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hananirfan91@gmail.com

# Optional Firebase Web Push VAPID Key (from Firebase Console -> Cloud Messaging -> Web Push certificates)
VITE_FIREBASE_VAPID_KEY=

# Secret token used by Vercel Cron or external scheduler to invoke /api/cron/daily-reminder
CRON_SECRET=

# Firebase Service Account JSON (stringified single-line JSON for Vercel serverless persistence & FCM HTTP v1)
FIREBASE_SERVICE_ACCOUNT_JSON=

# Optional comma-separated additional admin emails (defaults to hananirfan91@gmail.com)
ADMIN_EMAILS=hananirfan91@gmail.com
